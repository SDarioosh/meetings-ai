# Copy to .env (gitignored) and fill in. Every setting can also be passed as an
# environment variable or overridden by a CLI flag. This is the ONE place your
# server address lives.

# --- LLM (llama.cpp llama-server, OpenAI-compatible) ---
MEETINGS_LLM_BASE_URL=http://localhost:8080/v1
MEETINGS_LLM_MODEL=qwen3.5-35b
# Only needed if you started llama-server with --api-key
MEETINGS_LLM_API_KEY=
# json_schema (grammar-constrained) | markdown (strict sections) | auto (try json, fall back)
MEETINGS_LLM_OUTPUT_MODE=auto
# Disable Qwen3-style "thinking" for summaries (faster, cleaner JSON)
MEETINGS_LLM_DISABLE_THINKING=true
MEETINGS_LLM_TIMEOUT=600
MEETINGS_LLM_TEMPERATURE=0.2
# Transcripts longer than this (estimated tokens) are summarized in chunks, then merged
MEETINGS_MAX_TRANSCRIPT_TOKENS=60000

# --- Transcription (faster-whisper) ---
# large-v3-turbo on the GPU server; small/base for quick CPU tests on a laptop
MEETINGS_WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
MEETINGS_WHISPER_DEVICE=auto
# int8_float16 on CUDA, int8 on CPU (auto picks for you)
MEETINGS_WHISPER_COMPUTE_TYPE=auto
# Leave empty to auto-detect language
MEETINGS_LANGUAGE=
# Free Whisper's VRAM before calling the LLM (important when sharing a 12 GB card)
MEETINGS_UNLOAD_WHISPER=true

# --- Speaker detection (pyannote, optional: pip install -e "server[diarize]") ---
MEETINGS_DIARIZE=false
MEETINGS_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# Hugging Face read token; you must accept the model's terms on huggingface.co first
HF_TOKEN=

# --- Output ---
MEETINGS_OUTPUT_DIR=./meetings
MEETINGS_TEMPLATE=default
